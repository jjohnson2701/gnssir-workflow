[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    data,
    results_annual,
    gnssrefl_data_workspace,
    logs,
# E226 is in the flake8 default ignore list; it is named here because "ignore" replaces that list
ignore = E203, W503, E226
per-file-ignores =
    # long HTML and CSS text
    scripts/station_page.py: E501
